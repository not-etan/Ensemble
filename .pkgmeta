# Packaging for CurseForge, Wago and GitHub Releases (BigWigs packager, run by
# .github/workflows/release.yml when a version tag is pushed). The addon lives in the
# Ensemble/ subfolder; everything else in the repo stays out of the zip.
package-as: Ensemble

ignore:
  - tests
  - tools
  - docs
  - branding
  - dist
  - README.md
  - CHANGELOG.md
  - LICENSE
  - RELEASE_NOTES.md

move-folders:
  Ensemble/Ensemble: Ensemble

# Written by the workflow from this version's CHANGELOG.md section.
manual-changelog:
  filename: RELEASE_NOTES.md
  markup-type: markdown
